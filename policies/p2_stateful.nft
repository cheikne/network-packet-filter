# Rules on IP address, port, and protocol, with default drop
# Connection tracking and TCP flag checks
flush ruleset

table inet filter {
    chain forward {
        # Drop by default
        type filter hook forward priority 0; policy drop;

        # Drop invalid packets
        ct state invalid drop

        # Accept established replies
        ct state established, related accept

        # Allow connections from legit IP
        iifname "eth1" oifname "eth2" ip saddr 10.0.1.10 ip daddr 10.0.2.10 ct state new tcp dport {22, 443} accept

        # Allow legit DNS
        iifname "eth1" oifname "eth2" ip saddr 10.0.1.10 ip daddr 10.0.2.10 udp dport 53 accept
    
        # Drop tcp flags consisting only of SYN if all other rules don't apply
        iifname "eth1" oifname "eth2" tcp flags & (fin|syn|rst|ack) == syn drop
    }
}