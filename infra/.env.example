# Personal settings for the lab. Copy this file to infra/.env and edit it.
# infra/.env is git-ignored, so your changes stay on your machine.

# Which client nodes to start. fw and server always start.
#   legit,susp  -> full lab (use this for official runs)
#   legit       -> legitimate client only
#   susp        -> suspicious client only
COMPOSE_PROFILES=legit,susp

# Resources for each node (lower them on a small laptop)
NODE_CPUS=1
NODE_MEMORY=512m

# Size of the large download file on the server (http://10.0.2.10/large.bin)
LARGE_FILE_MB=50

# SSH lab account on the server. Choose your own values here (this file is
# public, infra/.env is not). Traffic scripts read them as $LAB_SSH_USER and
# $LAB_SSH_PASSWORD on the clients.
LAB_SSH_USER=change-me
LAB_SSH_PASSWORD=change-me
